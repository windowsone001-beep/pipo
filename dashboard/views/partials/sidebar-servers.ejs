<aside class="sidebar">
  <div class="sidebar-head">
    <a href="/dashboard"><%- include('brand') %></a>
  </div>

  <div class="search-bar" style="margin:0 4px 14px;max-width:none">
    <span class="ic"><i class="fa-solid fa-magnifying-glass"></i></span>
    <input type="text" placeholder="Search servers…" data-filter-target=".server-nav-item">
  </div>

  <div class="nav-group" style="flex:1;overflow-y:auto">
    <div class="nav-label">Your servers</div>
    <% guilds.forEach(g => { %>
      <a class="nav-link server-nav-item" data-search="<%= g.name %>" href="/dashboard/<%= g.id %>/overview">
        <span class="server-icon" style="width:24px;height:24px;font-size:10px;border-radius:6px;flex-shrink:0">
          <% if (g.icon) { %><img src="<%= g.icon %>" alt=""><% } else { %><%= g.name.charAt(0).toUpperCase() %><% } %>
        </span>
        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= g.name %></span>
      </a>
    <% }) %>
    <% if (!guilds.length) { %>
      <div style="padding:14px 12px;font-size:12.5px;color:var(--muted)">No manageable servers found yet.</div>
    <% } %>
  </div>
</aside>
<div class="sidebar-backdrop"></div>
