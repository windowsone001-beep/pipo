<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: title || 'Error' }) %>
</head>
<body>
  <div class="center-page">
    <div class="card center-card glass">
      <div class="ic"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <h1><%= title || 'Something went wrong' %></h1>
      <p><%= message || 'Please try again.' %></p>
      <a class="btn" href="/"><i class="fa-solid fa-arrow-left"></i> Back home</a>
    </div>
  </div>
</body>
</html>
