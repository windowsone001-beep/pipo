{
  "name": "minecore-manager",
  "version": "1.0.0",
  "description": "MineCore Manager — a modular, production-ready Discord bot (discord.js v14, local JSON storage)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "concurrently -n BOT,DASHBOARD -c \"blue,magenta\" \"node index.js\" \"node dashboard/server.js\"",
    "bot": "node index.js",
    "dashboard": "node dashboard/server.js",
    "dev": "concurrently -n BOT,DASHBOARD -c \"blue,magenta\" \"nodemon index.js\" \"nodemon dashboard/server.js\"",
    "deploy": "node handlers/deployCommands.js"
  },
  "dependencies": {
    "discord.js": "^14.15.3",
    "@discordjs/voice": "^0.17.0",
    "@discordjs/rest": "^2.3.0",
    "distube": "^5.0.4",
    "@distube/ytdl-core": "^4.14.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ejs": "^3.1.10",
    "node-cron": "^3.0.3",
    "chalk": "^4.1.2",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "mongodb": "^6.10.0",
    "concurrently": "^8.2.2",
    "discord-html-transcripts": "^3.2.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
